  "data_stream": {},
  "priority": 500,
  "_meta": {
    "derived_from": "obs-pi-pre-prod-us-east-1 :: .ds-logs-pr000410-standard-ds-defaultv1-000033",
    "purpose": "Mirror the customer OTel-logs schema for PPL perf/load/use-case mock indices.",
    "notes": [
      "Body-format variation (kv/json-*/nested) is CONTENT variation ingested into THIS single schema via the 5 dynamic_templates; not separate mappings.",
      "number_of_shards is a Tier knob: Tier-1 local = 1; Tier-2 sized to ~12.8GB/shard per the sizing doc.",
      "data_stream => append-only, auto _id, op_type=create. If controlled custom-_id seeding is needed for expected-value correctness, switch to plain indices + rollover alias."
    ]
  },
  "template": {
    "settings": {
      "number_of_shards": 1,
      "number_of_replicas": 1,
      "index.mapping.total_fields.limit": 2000,
      "index.refresh_interval": "30s"
    },
