          "resource_attributes": {
            "path_match": "resource.attributes.*",
            "match_mapping_type": "string",
            "mapping": {
              "type": "keyword"
            }
          }
        },
        {
          "attributes": {
            "path_match": "attributes.*",
            "match_mapping_type": "string",
            "mapping": {
              "type": "keyword"
            }
          }
        },
        {
          "log_fields_string": {
            "path_match": "log.**",
            "match_mapping_type": "string",
            "mapping": {
              "fields": {
                "keyword": {
                  "ignore_above": 256,
                  "type": "keyword"
                }
              },
              "norms": false,
              "type": "text"
            }
          }
        },
        {
          "log_fields_object": {
            "path_match": "log.**",
            "match_mapping_type": "object",
            "mapping": {
              "type": "object"
            }
          }
        },
        {
          "log_fields_non_string": {
            "path_match": "log.**",
            "mapping": {
              "type": "keyword"
            }
          }
        }
      ],
